# Copy to .env for local runs. In production, set these in the host's settings
# instead (see app/README.md). Never commit the real values.

# --- Required ---
# At least 12 characters. The only thing between the internet and your data.
APP_PASSWORD=
# Postgres. Supabase: Connect > Session pooler > URI
DATABASE_URL=
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Optional: each one switches on a source ---
# Google Calendar > Settings > your calendar > Secret address in iCal format (comma-separate several)
GOOGLE_CALENDAR_ICS_URL=
# Fine-grained GitHub token: `brain` repo only, Contents read-only
BRAIN_GITHUB_TOKEN=
# The SEC requires a contact, e.g. "Project Research you@example.com"
SEC_USER_AGENT=
TIMEZONE=America/New_York
# HOME_LOCATION=Austin, TX

# --- Rarely needed ---
# CLAUDE_MODEL=claude-opus-5-5
# ATLAS_MODEL=
# COMPASS_MODEL=
# BRAIN_REPO=stoneking-anthony/brain
# PEM of the database's CA certificate, to verify it
# DATABASE_CA=
# PORT=3000
